              <td><a class="ref" data-ref="Romans 3:24">Romans 3:24</a>;
              <a class="ref" data-ref="Romans 5:1">Romans 5:1</a>;
              <a class="ref" data-ref="Titus 2:11">Titus 2:11</a>;
              <a class="ref" data-ref="Hebrews 12:14">Hebrews 12:14</a></td>
            </tr>
          </tbody>
        </table>

